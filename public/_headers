# Security headers for static hosts that read this file (Netlify, Cloudflare Pages).
# Keep in step with vite.config.ts. Paths do not overlap, so no policy is merged with another.
# The microphone is allowed on Kerf's own page only, for voice input, and the
# camera for an app's camera panel.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; connect-src 'self' https://api.anthropic.com https://api.openai.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; connect-src 'self' https://api.anthropic.com https://api.openai.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY

# The OpenCASCADE kernel worker: the only code allowed eval, and it has no network access beyond Kerf's own files.
/assets/worker-*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self'

# The feasibility solver worker: plain code, no network.
/assets/solver.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The stress analysis worker: plain arithmetic on meshes, no network.
/assets/fea.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The airflow worker: WebGPU compute or plain arithmetic, no network.
/assets/aero.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The circuit simulation worker (Sound tab): plain arithmetic, no network.
/assets/render.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The circuit board routing worker: plain geometry, no network.
/assets/route.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The simulation worker: firmware compiled to closures on a virtual chip, no eval, no network.
/assets/sim.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The photoreal view's BVH worker: sorts triangles, no network.
/assets/bvh.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The 3D wiring's cable router: plain geometry on meshes, no network.
/assets/cables.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

# The page an app's custom drawing panels run in: framed by Kerf only, in a
# sandbox with no origin of its own. Their code may use eval, and nothing else.
/app-sandbox.html
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; frame-ancestors 'self'

# An app's simulated twin: firmware compiled to closures on a virtual chip, no eval, no network.
/assets/twin.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'

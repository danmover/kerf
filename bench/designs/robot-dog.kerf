  cut box(20, 30, 10, at: (160, 0, 61), r: 6) as arm_window
  cut cylinder(d: 3.4, h: 6, at: (102.25, -18, 57), dir: Z) as base_hole_1
  cut cylinder(d: 3.4, h: 6, at: (102.25, 0, 57), dir: Z) as base_hole_2
  cut cylinder(d: 3.4, h: 6, at: (102.25, 18, 57), dir: Z) as base_hole_3

part belly {
  label: "Belly plate: 2.5 mm carbon fibre sheet, waterjet cut"
  color: #1b1c1f
  material: "Carbon fiber"
  group: "Body"
  process: mfg.laser_cut(source: "waterjet")
  at: (0, 0, hz)
  body box(211, body_w + 3, 2.5, at: (0, 0, -64.5), r: 6) as sheet_

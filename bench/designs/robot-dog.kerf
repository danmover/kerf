  cut cylinder(d: 6.5, h: 3.2, at: (60, bw2 - 2.5, 72.81), dir: Z) as boss_cb_3
  add cylinder(d: 9, h: 17.5, at: (-60, -(bw2 - 2.5), 58), dir: Z) as boss_4
  cut cylinder(d: 4.7, h: 19, at: (-60, -(bw2 - 2.5), 57.5), dir: Z) as boss_hole_4
  cut cylinder(d: 6.5, h: 3.2, at: (-60, -(bw2 - 2.5), 72.81), dir: Z) as boss_cb_4

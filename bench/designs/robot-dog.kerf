  color: #8a8d91
  material: "Titanium"
  group: "Leg front right"
  process: mfg.cnc_lathe(axis: Y)
  at: (205 - (thigh_l * sth), -aby, hz - (thigh_l * cth))
  rotate: (0, qs, 0)

component term_r = lib.part("resistor_mf") { at: (-88, -30, hz + 30), group: "Electronics", held: "soldered into the bus harness at its last actuator, under heat-shrink", label: "120 ohm 1/4 W resistor: terminates the rear CAN bus at its far end" }
part cover {
  label: "Top cover: ASA, white, with the e-stop, switch, charge port and status light at the back"

  cut cylinder(d: 6.5, h: 3.2, at: (-102.25, -66, 72.81), dir: Z) as boss_cb_7
  add cylinder(d: 9, h: 17.5, at: (-102.25, 0, 58), dir: Z) as boss_8
  cut cylinder(d: 4.7, h: 19, at: (-102.25, 0, 57.5), dir: Z) as boss_hole_8
  cut cylinder(d: 6.5, h: 3.2, at: (-102.25, 0, 72.81), dir: Z) as boss_cb_8
  add cylinder(d: 9, h: 17.5, at: (-102.25, 66, 58), dir: Z) as boss_9
  cut cylinder(d: 4.7, h: 19, at: (-102.25, 66, 57.5), dir: Z) as boss_hole_9
  cut cylinder(d: 6.5, h: 3.2, at: (-102.25, 66, 72.81), dir: Z) as boss_cb_9
  cut box(4, 44, 4, at: (-24, 14, 72.5), r: 1.9) as vent_1
  cut box(4, 44, 4, at: (-18, 14, 72.5), r: 1.9) as vent_2
  cut box(4, 44, 4, at: (-12, 14, 72.5), r: 1.9) as vent_3
  cut box(4, 44, 4, at: (-6, 14, 72.5), r: 1.9) as vent_4
  cut box(4, 44, 4, at: (0, 14, 72.5), r: 1.9) as vent_5
  cut box(4, 44, 4, at: (6, 14, 72.5), r: 1.9) as vent_6
  cut box(4, 44, 4, at: (12, 14, 72.5), r: 1.9) as vent_7
  cut cylinder(d: 22.5, h: 5, at: (-80, 0, 72), dir: Z) as estop_hole

  cut cylinder(d: 3.4, h: 8.5, at: (98, -aby - 37.616, 5.392), dir: X) as m_r_1
  cut cylinder(d: 3.4, h: 8.5, at: (98, -aby - 23.477, -29.88), dir: X) as m_r_2
  cut cylinder(d: 3.4, h: 8.5, at: (98, -aby + 14.138, -35.272), dir: X) as m_r_3

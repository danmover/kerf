design "Robot Dog"
note "A 15.6 kg four-legged robot in the class of MIT's Mini Cheetah: twelve CubeMars AK70-10 quasi-direct-drive actuators (24.8 N.m peak, 10:1 planetary, 14-bit encoder) on two CAN buses, an NVIDIA Jetson Orin Nano Super for perception and planning, an Intel RealSense D435i depth camera in the head, and a Teensy 4.1 that runs the 500 Hz leg control. A Tattu 6S 10 Ah LiPo (222 Wh) gives about an hour of walking at 150 to 200 W. Rendered and simulated in Kerf; not yet built."
note "Each leg: the ab/ad actuator sits in the bulkhead with its output along the body; it swings an orange hip carrier that holds the hip actuator crosswise; the hip actuator turns the thigh, a box of two 7075 plates. The knee actuator rides on the thigh 80 mm below the hip in a black cup and drives the knee through an HTD 8M belt, 20 mm wide, on two 22-tooth pulleys (1:1), so the knee keeps the actuator's full 24.8 N.m. The knee pulley runs in a 6808 bearing in the outer plate and a 12 mm knee pin in a 6801 in the inner plate; the knee crank on the pulley's hub holds a 20 mm carbon shank tube with a 42 mm TPU ball foot."

brief {
  purpose: "A four-legged robot dog of about 15 kg in the class of MIT's Mini Cheetah: it stands up from lying folded, walks and trots on twelve quasi-direct-drive actuators, sees with a depth camera in its head and walks for about an hour on one battery"
  setting: "Indoors on hard floors and short carpet, in a lab or a home, built and run by a robotics student or a maker; people stand near it while it walks"
  priorities: ["real, buyable actuators, boards and battery, drawn as the products", "every joint and board screwed down, every cable modelled", "an e-stop that cuts all twelve actuators in hardware", "each leg's supply fused", "about an hour of walking on one charge", "machined aluminium where loads go, printed covers where they do not", "parts from Australian shops"]
  look: "Black anodised body with white printed covers, orange hip carriers, clear anodised thighs, carbon shanks and black rubber feet, a dark glass face over the depth camera"

  temp: 5C .. 40C
  outdoor: false

  process: mfg.cnc_mill(tool_d: 6)
  material: "Aluminum 6061"
  quantity: 1

  use walk "Stands up from lying folded and trots at up to 0.5 m/s on its own firmware, the actuators commanded over CAN" { on: belly }
  use safe "Goes limp when the e-stop is pressed: the relay drops and every actuator loses power" { on: cover }
  use land "Lands from a 15 cm drop on one foot (three times body weight through one leg) with every leg part inside its limit" { on: fl_thigh_out }

  given t_peak = 24.8Nm "CubeMars AK70-10 KV100 peak torque at 24 V (CubeMars product page and its driver manual); rated 8.3 N.m"
  given body_mass = 15.6kg "the design's own mass: made parts by their volume and material, bought parts at their catalogue weights; the wiring not counted"

  reference ak70 "CubeMars AK70-10 actuator: drawings, MIT-mode CAN protocol, specs" { url: "https://www.cubemars.com/goods-1031-AK70-10.html" }
  reference teensy "PJRC Teensy 4.1: pinout and CAN pins" { url: "https://www.pjrc.com/store/teensy41.html" }
  reference flexcan "FlexCAN_T4, the Teensy 4 CAN library" { url: "https://github.com/tonton81/FlexCAN_T4" }
  reference jetson "NVIDIA Jetson Orin Nano Super Developer Kit" { url: "https://developer.nvidia.com/embedded/learn/jetson-orin-nano-devkit-user-guide/index.html" }
  reference d435i "Intel RealSense D435i depth camera: datasheet and drawing" { url: "https://www.intelrealsense.com/depth-camera-d435i/" }
  reference battery "Tattu 10000 mAh 6S 25C LiPo, XT90" { url: "https://genstattu.com/tattu-10000mah-22-2v-25c-6s1p-lipo-battery-pack-with-xt90-plug/" }
  reference cheetah "Katz, Di Carlo, Kim: Mini Cheetah, a platform for pushing the limits of dynamic quadruped control (ICRA 2019)" { url: "https://dspace.mit.edu/handle/1721.1/126619" }

  assume "Each actuator's zero is set once on a jig in the standing pose; the firmware counts every joint angle from there"
  assume "Walking takes 150 to 200 W on hard floors (Mini Cheetah class robots), so the 222 Wh pack gives about an hour"
  assume "The knee belt runs at 560 N installed tension, set with the knee actuator's slotted mount in its cup"
}


param thigh_l = 210 range 190 .. 240 "Thigh: hip axis to knee axis, mm"
param shank_l = 210 range 190 .. 240 "Shank: knee axis to the centre of the foot, mm"
param body_w = 200 range 200 .. 240 "Body: width across the side plates, mm"
param stand_h = 320 range 290 .. 360 "Standing height: hip axes over the floor, mm"

// the pose drawn: standing, every foot under its hip; leg angles from the two lengths and the height
let hz = stand_h
let bw2 = body_w / 2
let aby = bw2 - 52.5
let leg_d = hz - 21
let th = acos((thigh_l * thigh_l + leg_d * leg_d - shank_l * shank_l) / (2 * thigh_l * leg_d))
let cth = cos(th)
let sth = sin(th)
let qs = atan2(-thigh_l * sth, leg_d - thigh_l * cth)
let cqs = cos(qs)
let sqs = sin(qs)
// the knee belt: the nearest made-to-order loop (8 mm steps) to a knee actuator 80 mm down the thigh,
// and the centres it sets when stretched to 560 N (EA 400 kN)
let belt_len = round(2 * (thigh_l - 80) + 176, step: 8)
let belt_c = (belt_len * (1 + 560 / 400000) - 176) / 2
let km = thigh_l - belt_c

part side_l {
  label: "Side plate, left: 5 mm 6061-T6, black anodised"
  color: #24272c
  material: "Aluminum 6061"
  group: "Body"
  process: mfg.cnc_mill(tool_d: 6, setups: [Y, -Y, Z, -Z])
  at: (0, 0, hz)
  finish: "anodized"
  body extrude(polygon([(-152, -62), (152, -62), (152, 44), (138, 58), (-138, 58), (-152, 44)], r: 4), 5, at: (0, bw2, 0), dir: -Y) as plate
  cut extrude(polygon([(-88, -48), (-12, -48), (-12, 40), (-76, 40)], r: 8), 7, at: (0, bw2 + 1, 0), dir: -Y) as window_1
  cut extrude(polygon([(12, -48), (88, -48), (76, 40), (12, 40)], r: 8), 7, at: (0, bw2 + 1, 0), dir: -Y) as window_2
  cut extrude(polygon([(110, 22), (136, 22), (136, 44), (128, 48), (110, 48)], r: 5), 7, at: (0, bw2 + 1, 0), dir: -Y) as window_3
  cut extrude(polygon([(-110, 22), (-110, 48), (-128, 48), (-136, 44), (-136, 22)], r: 5), 7, at: (0, bw2 + 1, 0), dir: -Y) as window_4
  cut cylinder(d: 40, h: 7, at: (128, bw2 + 1, -4), dir: -Y) as port_f
  cut cylinder(d: 4.5, h: 7, at: (102.25, bw2 + 1, -14), dir: -Y) as bh_f_36
  cut cylinder(d: 4.5, h: 7, at: (102.25, bw2 + 1, 13), dir: -Y) as bh_f_63
  cut cylinder(d: 4.5, h: 7, at: (102.25, bw2 + 1, 40), dir: -Y) as bh_f_90
  cut cylinder(d: 40, h: 7, at: (-128, bw2 + 1, -4), dir: -Y) as port_r
  cut cylinder(d: 4.5, h: 7, at: (-102.25, bw2 + 1, -14), dir: -Y) as bh_r_36
  cut cylinder(d: 4.5, h: 7, at: (-102.25, bw2 + 1, 13), dir: -Y) as bh_r_63
  cut cylinder(d: 4.5, h: 7, at: (-102.25, bw2 + 1, 40), dir: -Y) as bh_r_90
  cut cylinder(d: 2.5, h: 8, at: (-60, (bw2 - 5 + bw2) / 2, 50), dir: Z) as top_tap_40
  cut cylinder(d: 2.5, h: 8, at: (-60, (bw2 - 5 + bw2) / 2, -62.01), dir: Z) as belly_tap_40
  cut cylinder(d: 2.5, h: 8, at: (0, (bw2 - 5 + bw2) / 2, 50), dir: Z) as top_tap_100
  cut cylinder(d: 2.5, h: 8, at: (0, (bw2 - 5 + bw2) / 2, -62.01), dir: Z) as belly_tap_100
  cut cylinder(d: 2.5, h: 8, at: (60, (bw2 - 5 + bw2) / 2, 50), dir: Z) as top_tap_160
  cut cylinder(d: 2.5, h: 8, at: (60, (bw2 - 5 + bw2) / 2, -62.01), dir: Z) as belly_tap_160
  cut cylinder(d: 48, h: 7, at: (205 + (-km) * sth, bw2 + 1, hz + (-km) * cth - hz), dir: -Y) as pulley_relief
  chamfer(0.8, edges: along(Y))
}
component side_l_f_screws = lib.screw(M4, 14, head: "button") { at: [(102.25, bw2, hz - 14), (102.25, bw2, hz + 13), (102.25, bw2, hz + 40)], axis: -Y, group: "Body", label: "M4 x 14 button screw: left side plate to the front bulkhead" }
component side_l_r_screws = lib.screw(M4, 14, head: "button") { at: [(-102.25, bw2, hz - 14), (-102.25, bw2, hz + 13), (-102.25, bw2, hz + 40)], axis: -Y, group: "Body", label: "M4 x 14 button screw: left side plate to the rear bulkhead" }
part side_r {
  label: "Side plate, right: 5 mm 6061-T6, black anodised"
  color: #24272c
  material: "Aluminum 6061"
  group: "Body"
  process: mfg.cnc_mill(tool_d: 6, setups: [Y, -Y, Z, -Z])
  at: (0, 0, hz)
  finish: "anodized"
  body extrude(polygon([(-152, -62), (152, -62), (152, 44), (138, 58), (-138, 58), (-152, 44)], r: 4), 5, at: (0, -bw2 + 5, 0), dir: -Y) as plate
  cut extrude(polygon([(-88, -48), (-12, -48), (-12, 40), (-76, 40)], r: 8), 7, at: (0, -bw2 + 5 + 1, 0), dir: -Y) as window_1
  cut extrude(polygon([(12, -48), (88, -48), (76, 40), (12, 40)], r: 8), 7, at: (0, -bw2 + 5 + 1, 0), dir: -Y) as window_2
  cut extrude(polygon([(110, 22), (136, 22), (136, 44), (128, 48), (110, 48)], r: 5), 7, at: (0, -bw2 + 5 + 1, 0), dir: -Y) as window_3
  cut extrude(polygon([(-110, 22), (-110, 48), (-128, 48), (-136, 44), (-136, 22)], r: 5), 7, at: (0, -bw2 + 5 + 1, 0), dir: -Y) as window_4
  cut cylinder(d: 40, h: 7, at: (128, -bw2 + 5 + 1, -4), dir: -Y) as port_f
  cut cylinder(d: 4.5, h: 7, at: (102.25, -bw2 + 5 + 1, -14), dir: -Y) as bh_f_36
  cut cylinder(d: 4.5, h: 7, at: (102.25, -bw2 + 5 + 1, 13), dir: -Y) as bh_f_63
  cut cylinder(d: 4.5, h: 7, at: (102.25, -bw2 + 5 + 1, 40), dir: -Y) as bh_f_90
  cut cylinder(d: 40, h: 7, at: (-128, -bw2 + 5 + 1, -4), dir: -Y) as port_r
  cut cylinder(d: 4.5, h: 7, at: (-102.25, -bw2 + 5 + 1, -14), dir: -Y) as bh_r_36
  cut cylinder(d: 4.5, h: 7, at: (-102.25, -bw2 + 5 + 1, 13), dir: -Y) as bh_r_63
  cut cylinder(d: 4.5, h: 7, at: (-102.25, -bw2 + 5 + 1, 40), dir: -Y) as bh_r_90
  cut cylinder(d: 2.5, h: 8, at: (-60, (-bw2 + (-bw2 + 5)) / 2, 50), dir: Z) as top_tap_40
  cut cylinder(d: 2.5, h: 8, at: (-60, (-bw2 + (-bw2 + 5)) / 2, -62.01), dir: Z) as belly_tap_40
  cut cylinder(d: 2.5, h: 8, at: (0, (-bw2 + (-bw2 + 5)) / 2, 50), dir: Z) as top_tap_100
  cut cylinder(d: 2.5, h: 8, at: (0, (-bw2 + (-bw2 + 5)) / 2, -62.01), dir: Z) as belly_tap_100
  cut cylinder(d: 2.5, h: 8, at: (60, (-bw2 + (-bw2 + 5)) / 2, 50), dir: Z) as top_tap_160
  cut cylinder(d: 2.5, h: 8, at: (60, (-bw2 + (-bw2 + 5)) / 2, -62.01), dir: Z) as belly_tap_160
  cut cylinder(d: 48, h: 7, at: (205 + (-km) * sth, -bw2 + 5 + 1, hz + (-km) * cth - hz), dir: -Y) as pulley_relief
  chamfer(0.8, edges: along(Y))
}
component side_r_f_screws = lib.screw(M4, 14, head: "button") { at: [(102.25, -bw2, hz - 14), (102.25, -bw2, hz + 13), (102.25, -bw2, hz + 40)], axis: Y, group: "Body", label: "M4 x 14 button screw: right side plate to the front bulkhead" }
component side_r_r_screws = lib.screw(M4, 14, head: "button") { at: [(-102.25, -bw2, hz - 14), (-102.25, -bw2, hz + 13), (-102.25, -bw2, hz + 40)], axis: Y, group: "Body", label: "M4 x 14 button screw: right side plate to the rear bulkhead" }

component head_screws = lib.screw(M3, 10, head: "button") { at: [(102.25, -18, hz + 62), (102.25, 0, hz + 62), (102.25, 18, hz + 62)], axis: -Z, group: "Head", label: "M3 x 10 button screw: head bracket to the front bulkhead" }
component camera = lib.sensor("realsense_d435i") { at: (184, 0, hz + 88), axis: X, group: "Head", label: "Intel RealSense D435i depth camera: stereo depth and its own IMU, USB-C to the Jetson" }
component camera_screws = lib.screw(M3, 10, head: "pan") { at: [(177, -22.5, hz + 88), (177, 22.5, hz + 88)], axis: X, group: "Head", label: "M3 x 10 pan screw: through the head bracket's face plate into the camera's back" }
part head_shell {
  label: "Head shell: ASA, white, with the camera window"
  color: #e9e9e6
  material: "ASA"
  group: "Head"
  process: mfg.fdm(build: -Z, bed: (256, 256, 256))
  held: "slid down over the head bracket's arm and clipped under the base's front edge"
  at: (0, 0, hz)
  removable
  body box(120, 112, 52, at: (156, 0, 62), r: 14) as shell
  add box(69, 34.5, 24, at: (174.5, 67.25, 75), r: 6) as usb_pod
  cut box(115, 107, 50, at: (156, 0, 61.99), r: 12) as hollow
  cut box(64, 33, 19, at: (174.5, 66.5, 77.5), r: 4) as usb_pod_hollow
  cut box(12, 82, 27, at: (212, 0, 75), r: 4) as window
  cut box(30, 3, 4, at: (150, -18, 111), r: 1.4) as vent_1
  cut box(30, 3, 4, at: (150, -6, 111), r: 1.4) as vent_2
  cut box(30, 3, 4, at: (150, 6, 111), r: 1.4) as vent_3
  cut box(30, 3, 4, at: (150, 18, 111), r: 1.4) as vent_4
}
wire batt.POS -> xt90.POS_A { insulation: "silicone", gauge: 10, color: "red" }
wire batt.NEG -> xt90.NEG_A { insulation: "silicone", gauge: 10, color: "black" }
wire xt90.POS_B -> maxi.IN { insulation: "silicone", gauge: 10, color: "red" }
wire maxi.OUT -> w_bat.A { insulation: "silicone", gauge: 10, color: "red" }
wire w_bat.B -> relay.COM_30 { insulation: "silicone", gauge: 10, color: "red" }
wire relay.NO_87 -> w_mot.A { insulation: "silicone", gauge: 10, color: "red" }
wire xt90.NEG_B -> w_g1.A { insulation: "silicone", gauge: 10, color: "black" }
wire w_g1.B -> w_g2.A { insulation: "silicone", gauge: 10, color: "black" }
wire w_bat.C -> charge.POS_B { insulation: "silicone", gauge: 12, color: "red", label: "charge port +" }
wire charge.NEG_B -> w_g2.B { insulation: "silicone", gauge: 12, color: "black", label: "charge port -" }
wire w_mot.B -> fuse_fl.IN { insulation: "silicone", gauge: 12, color: "red" }
wire fuse_fl.OUT -> fl_abad.V_PLUS -> fl_hip.V_PLUS -> fl_knee.V_PLUS { gauge: 14, insulation: "silicone", color: "red", label: "front left leg supply" }
wire w_g1.C -> fl_abad.GND -> fl_hip.GND -> fl_knee.GND { gauge: 14, insulation: "silicone", color: "black", label: "front left leg ground" }
wire w_mot.C -> fuse_fr.IN { insulation: "silicone", gauge: 12, color: "red" }
wire fuse_fr.OUT -> fr_abad.V_PLUS -> fr_hip.V_PLUS -> fr_knee.V_PLUS { gauge: 14, insulation: "silicone", color: "red", label: "front right leg supply" }
wire w_g1.D -> fr_abad.GND -> fr_hip.GND -> fr_knee.GND { gauge: 14, insulation: "silicone", color: "black", label: "front right leg ground" }
wire w_mot.D -> fuse_rl.IN { insulation: "silicone", gauge: 12, color: "red" }
wire fuse_rl.OUT -> rl_abad.V_PLUS -> rl_hip.V_PLUS -> rl_knee.V_PLUS { gauge: 14, insulation: "silicone", color: "red", label: "rear left leg supply" }
wire w_g1.E -> rl_abad.GND -> rl_hip.GND -> rl_knee.GND { gauge: 14, insulation: "silicone", color: "black", label: "rear left leg ground" }
wire w_mot.E -> fuse_rr.IN { insulation: "silicone", gauge: 12, color: "red" }
wire fuse_rr.OUT -> rr_abad.V_PLUS -> rr_hip.V_PLUS -> rr_knee.V_PLUS { gauge: 14, insulation: "silicone", color: "red", label: "rear right leg supply" }
wire w_g2.C -> rr_abad.GND -> rr_hip.GND -> rr_knee.GND { gauge: 14, insulation: "silicone", color: "black", label: "rear right leg ground" }
wire w_bat.D -> fuse_logic.IN { insulation: "silicone", gauge: 12, color: "red" }
wire fuse_logic.OUT -> power_sw.A { insulation: "silicone", gauge: 18, color: "red" }
net V_LOGIC: power_sw.B, reg12.VIN, reg5.VIN, estop.NC_1 { insulation: "silicone", gauge: 18, color: "red" }
wire estop.NC_2 -> relay.COIL_86 { gauge: 20, color: "orange", label: "relay coil, through the e-stop" }
net GND_LOGIC: w_g2.D, reg12.GND, reg5.GND, relay.COIL_85, jetson.GND { insulation: "silicone", gauge: 18, color: "black" }
wire reg12.VOUT -> jetson.DC_IN { gauge: 18, color: "red", label: "12 V to the Jetson's barrel jack" }
net V5: reg5.VOUT, teensy.VIN, leds.V5, txb.VB { gauge: 20, color: "red" }
net GND_5: reg5.GND, teensy.GND, leds.GND, txb.GND, can_f.GND, can_r.GND, imu.GND, estop.NO_4 { gauge: 22, color: "black" }
net V3: teensy.V3V3, txb.VA, can_f.V3V3, can_r.V3V3, imu.VIN { gauge: 24, color: "orange" }
wire teensy.D22 -> can_f.CAN_TX { gauge: 26, color: "white", label: "CAN1 TX: front bus" }
wire can_f.CAN_RX -> teensy.D23 { gauge: 26, color: "blue", label: "CAN1 RX: front bus" }
wire teensy.D1 -> can_r.CAN_TX { gauge: 26, color: "white", label: "CAN2 TX: rear bus" }
wire can_r.CAN_RX -> teensy.D0 { gauge: 26, color: "blue", label: "CAN2 RX: rear bus" }
wire teensy.D18 -> imu.SDA { gauge: 26, color: "blue", label: "I2C SDA" }
wire teensy.D19 -> imu.SCL { gauge: 26, color: "yellow", label: "I2C SCL" }
wire teensy.D2 -> txb.A1 { gauge: 26, color: "green", label: "LED data, 3.3 V" }
wire txb.B1 -> leds.DIN { gauge: 26, color: "green", label: "LED data, 5 V" }
wire teensy.D3 -> estop.NO_3 { gauge: 24, color: "white", label: "e-stop sense" }
wire teensy.USB -> jetson.USB1 { cable: "USB micro-B to A cable, 300 mm", length: 300 }
wire camera.USB -> jetson.USB3 { cable: "USB-C to USB-A 3.1 cable, 500 mm", length: 500, via: [(190, 77, hz + 88), (152, 74, hz + 84), (147, 50, hz + 80), (120, 48, hz + 66), (102.25, aby, hz + 51.5)] }
net CANF_H: can_f.CAN_H, fl_abad.CAN_H, fl_hip.CAN_H, fl_knee.CAN_H, fr_knee.CAN_H, fr_hip.CAN_H, fr_abad.CAN_H, term_f.A { gauge: 26, color: "yellow", chain: true }
net CANF_L: can_f.CAN_L, fl_abad.CAN_L, fl_hip.CAN_L, fl_knee.CAN_L, fr_knee.CAN_L, fr_hip.CAN_L, fr_abad.CAN_L, term_f.B { gauge: 26, color: "green", chain: true }
net CANR_H: can_r.CAN_H, rl_abad.CAN_H, rl_hip.CAN_H, rl_knee.CAN_H, rr_knee.CAN_H, rr_hip.CAN_H, rr_abad.CAN_H, term_r.A { gauge: 26, color: "yellow", chain: true }
net CANR_L: can_r.CAN_L, rl_abad.CAN_L, rl_hip.CAN_L, rl_knee.CAN_L, rr_knee.CAN_L, rr_hip.CAN_L, rr_abad.CAN_L, term_r.B { gauge: 26, color: "green", chain: true }
// ── Firmware: the Teensy 4.1 runs the legs at 500 Hz over both CAN buses; the Jetson sends it lines on USB ──
firmware gait {
  board: teensy
  behaviour: "quadruped robot dog: stands up from lying folded and trots, on twelve CAN actuators"
  legs: "fl, fr, rl, rr"
  thigh: thigh_l
  shank: shank_l
  stand: stand_h
  foot_r: 21
  leg_y: 129.6
  period: 0.36
  swing: 60
  max_speed: 0.6
  kp: 180
  kd: 3
  mass: 15.6
}

// ── Simulation: each leg's three bodies on its three actuators' axes; every angle counts from the standing pose ──
// lying folded: thigh 140 deg from straight down, knee folded 140 deg; the knee folds at most 144 deg
// (its shank tube meets the knee actuator's cup) and at least 20 deg
let fl_carrier_body = [fl_carrier, fl_carrier_screws, fl_hip, fl_hip_screws]
let fl_thigh_body = [fl_thigh_in, fl_thigh_out, fl_post_1, fl_post_2, fl_post_3, fl_post_screws_in, fl_post_screws_out, fl_thigh_screws, fl_cup, fl_cup_screws, fl_cup_post_screws, fl_knee, fl_knee_m_screws, fl_mpul, fl_mpul_screws, fl_belt, fl_b6808, fl_b6801]
let fl_shank_body = [fl_kpul, fl_crank, fl_crank_screws, fl_pin, fl_pin_screw, fl_tube, fl_foot_hub, fl_foot]
let fl_abad_j = sim.pivot(fl_carrier_body, at: (149.5, aby, hz), axis: (1, 0, 0), limits: (-26, 26), drive: fl_abad, friction: 300, name: "fl_abad_joint")
let fl_hip_j = sim.pivot(fl_thigh_body, on: fl_carrier, at: (205, aby + 73, hz), axis: (0, 1, 0), limits: (-34.4 - th, 149 - th), start: 140 - th, drive: fl_hip, friction: 300, name: "fl_hip_joint")
let fl_knee_j = sim.pivot(fl_shank_body, on: fl_thigh_in, at: (205 - (thigh_l * sth), aby + 129.6, hz - (thigh_l * cth)), axis: (0, -1, 0), limits: (-(th - qs - 20), -(th - qs - 144)), start: -(th - qs - 140), drive: fl_knee, friction: 300, name: "fl_knee_joint")
let fr_carrier_body = [fr_carrier, fr_carrier_screws, fr_hip, fr_hip_screws]
let fr_thigh_body = [fr_thigh_in, fr_thigh_out, fr_post_1, fr_post_2, fr_post_3, fr_post_screws_in, fr_post_screws_out, fr_thigh_screws, fr_cup, fr_cup_screws, fr_cup_post_screws, fr_knee, fr_knee_m_screws, fr_mpul, fr_mpul_screws, fr_belt, fr_b6808, fr_b6801]
let fr_shank_body = [fr_kpul, fr_crank, fr_crank_screws, fr_pin, fr_pin_screw, fr_tube, fr_foot_hub, fr_foot]
let fr_abad_j = sim.pivot(fr_carrier_body, at: (149.5, -aby, hz), axis: (1, 0, 0), limits: (-26, 26), drive: fr_abad, friction: 300, name: "fr_abad_joint")
let fr_hip_j = sim.pivot(fr_thigh_body, on: fr_carrier, at: (205, -(aby + 73), hz), axis: (0, -1, 0), limits: (-(149 - th), -(-34.4 - th)), start: -(140 - th), drive: fr_hip, friction: 300, name: "fr_hip_joint")
let fr_knee_j = sim.pivot(fr_shank_body, on: fr_thigh_in, at: (205 - (thigh_l * sth), -(aby + 129.6), hz - (thigh_l * cth)), axis: (0, 1, 0), limits: (th - qs - 144, th - qs - 20), start: th - qs - 140, drive: fr_knee, friction: 300, name: "fr_knee_joint")
let rl_carrier_body = [rl_carrier, rl_carrier_screws, rl_hip, rl_hip_screws]
let rl_thigh_body = [rl_thigh_in, rl_thigh_out, rl_post_1, rl_post_2, rl_post_3, rl_post_screws_in, rl_post_screws_out, rl_thigh_screws, rl_cup, rl_cup_screws, rl_cup_post_screws, rl_knee, rl_knee_m_screws, rl_mpul, rl_mpul_screws, rl_belt, rl_b6808, rl_b6801]
let rl_shank_body = [rl_kpul, rl_crank, rl_crank_screws, rl_pin, rl_pin_screw, rl_tube, rl_foot_hub, rl_foot]
let rl_abad_j = sim.pivot(rl_carrier_body, at: (-149.5, aby, hz), axis: (-1, 0, 0), limits: (-26, 26), drive: rl_abad, friction: 300, name: "rl_abad_joint")
let rl_hip_j = sim.pivot(rl_thigh_body, on: rl_carrier, at: (-205, aby + 73, hz), axis: (0, 1, 0), limits: (-34.4 - th, 149 - th), start: 140 - th, drive: rl_hip, friction: 300, name: "rl_hip_joint")
let rl_knee_j = sim.pivot(rl_shank_body, on: rl_thigh_in, at: (-205 - (thigh_l * sth), aby + 129.6, hz - (thigh_l * cth)), axis: (0, -1, 0), limits: (-(th - qs - 20), -(th - qs - 144)), start: -(th - qs - 140), drive: rl_knee, friction: 300, name: "rl_knee_joint")
let rr_carrier_body = [rr_carrier, rr_carrier_screws, rr_hip, rr_hip_screws]
let rr_thigh_body = [rr_thigh_in, rr_thigh_out, rr_post_1, rr_post_2, rr_post_3, rr_post_screws_in, rr_post_screws_out, rr_thigh_screws, rr_cup, rr_cup_screws, rr_cup_post_screws, rr_knee, rr_knee_m_screws, rr_mpul, rr_mpul_screws, rr_belt, rr_b6808, rr_b6801]
let rr_shank_body = [rr_kpul, rr_crank, rr_crank_screws, rr_pin, rr_pin_screw, rr_tube, rr_foot_hub, rr_foot]
let rr_abad_j = sim.pivot(rr_carrier_body, at: (-149.5, -aby, hz), axis: (-1, 0, 0), limits: (-26, 26), drive: rr_abad, friction: 300, name: "rr_abad_joint")
let rr_hip_j = sim.pivot(rr_thigh_body, on: rr_carrier, at: (-205, -(aby + 73), hz), axis: (0, -1, 0), limits: (-(149 - th), -(-34.4 - th)), start: -(140 - th), drive: rr_hip, friction: 300, name: "rr_hip_joint")
let rr_knee_j = sim.pivot(rr_shank_body, on: rr_thigh_in, at: (-205 - (thigh_l * sth), -(aby + 129.6), hz - (thigh_l * cth)), axis: (0, 1, 0), limits: (th - qs - 144, th - qs - 20), start: th - qs - 140, drive: rr_knee, friction: 300, name: "rr_knee_joint")
let legs = sim.mechanism(fl_abad_j, fl_hip_j, fl_knee_j, fr_abad_j, fr_hip_j, fr_knee_j, rl_abad_j, rl_hip_j, rl_knee_j, rr_abad_j, rr_hip_j, rr_knee_j, base: "free", auto: false, follow: belly)

scenario "Stands up and trots across the floor" for walk {
  world: sim.floor(surface: "concrete")
  mechanism: legs
  firmware: gait
  duration: 12s
  console: [sim.type("on", at: 0.5s), sim.type("stand", at: 1s), sim.type("trot 0.25", at: 5s), sim.type("trot 0.5", at: 6.5s), sim.type("stop", at: 10s), sim.type("st", at: 11.6s)]
  expect "It stood up and walked off on its own firmware, every command taken": fw.refused == 0 && fw.faults == 0 && state == "standing"
  expect "It trotted at least 1.5 m": distance > 1500
  expect "It never tipped": !tipped && tilt_max < 20
  expect "Every actuator answered every frame": can_unanswered == 0 && fw.lostReplies == 0 && can_lost == 0
  expect "The CAN buses kept a fifth of their time free": can_load < 0.8
  expect "The battery fuse and the legs' fuses held": !fuse_blown && maxi.peak_draw < 40
}

scenario "E-stop while standing" for safe {
  like: "Stands up and trots across the floor"
  duration: 9s
  console: [sim.type("on", at: 0.5s), sim.type("stand", at: 1s), sim.type("trot 0.3", at: 9s)]
  faults: [sim.press(estop, at: 5.5s, until: 7.5s)]
  expect "It saw the e-stop and the relay cut the legs' power": fw.faults == 1 && state == "limp"
  expect "It settled down on its belly, not over": !tipped
}

// landing on one foot: 3 x body weight up through the foot (body_mass is in grams, t_peak in N.mm)
let land_f = 3 * 9.81 * body_mass / 1000
let land_m = land_f * abs(sin(qs)) * (shank_l - 64)      // N.mm, bending the shank tube where it leaves the crank
let tube_z = 3.14159 * (20 * 20 * 20 * 20 - 17 * 17 * 17 * 17) / (32 * 20)   // mm³, the 20 x 17 tube's section modulus
let knee_hold = land_f * abs(sin(qs)) * shank_l           // N.mm the knee would need to hold it in the standing pose
require "Landing on one foot: the shank tube bends to under half its strength (450 MPa) at 3 x body weight" for land: land_m / tube_z <= 450 / 2
require "Landing on one foot: the knee actuator gives way at its peak torque before the knee belt is overloaded (1060 N on its 22-tooth pulley)" for land: t_peak / (22 * 8 / 3.14159 / 2) <= 1060
require "Landing on one foot: more than the knee holds in the standing pose, so it backdrives and the leg folds to soak up the drop" for land: knee_hold > t_peak
analysis "Landing on one foot: 3 x body weight up the front left shank" {
  parts: [fl_crank, fl_tube, fl_foot_hub]
  fix: zone(at: (205 - (thigh_l * sth), aby + 116.1, hz - (thigh_l * cth)), r: 24)     // the crank's disc, screwed to the knee pulley's hub and on the knee pin
  load: force(zone(at: (205 - (thigh_l * sth) + (-shank_l) * sqs, aby + 129.6, hz - (thigh_l * cth) + (-shank_l) * cqs), r: 16), (0, 0, land_f))
  safety: 2
  resolution: "draft"
}

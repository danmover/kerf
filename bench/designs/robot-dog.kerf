  add cylinder(d: 16, h: 1, at: (0, -79.05, 0), dir: Y) as collar
  add cylinder(d: 18, h: 3, at: (0, -129.1, 0), dir: Y) as head
  cut cylinder(d: 4.2, h: 10, at: (0, -82.99, 0), dir: Y) as tap
  cut cylinder(d: 6, h: 43.1, at: (0, -129.11, 0), dir: Y) as bore
}

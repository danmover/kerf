component rl_abad_screws = lib.screw(M3, 12) { at: [(-99, aby + 37.616, hz + 5.392), (-99, aby + 23.477, hz - 29.88), (-99, aby - 14.138, hz - 35.272), (-99, aby - 37.616, hz - 5.392), (-99, aby - 23.477, hz + 29.88), (-99, aby + 14.138, hz + 35.272)], axis: -X, group: "Body", label: "M3 x 12 socket screw: rear left ab/ad actuator to the rear bulkhead" }

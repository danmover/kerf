design "Zephyr Fox"
note "Island pet Zephyr Fox (Rare, Cloud Island): a sky-blue fox with white muzzle, cheeks, chest and paw tips, two large pointed ears with white inner panels and darker blue tips, a small dark-blue nose, and a slim compact body on four short legs. One big tail ends in a single chunky white cloud swirl. Chunky low-poly game style with an oversized head; the face is left blank for the expression decals."
note "Coordinates: X right, Y back, Z up, in millimetres; the fox faces -Y and stands on z = 0."

let sky   = #7ec4ef
let white = #fbfcff
let tip   = #3b7cc6
let nose  = #23406e

// one ear, drawn upright round its base, with its white inner panel and dark tip
let ear = [
  organic.slab(points: [(-12.5, 0), (12.5, 0), (0, 29)], t: 11, r: 4.5),
  organic.paint(organic.slab(points: [(-7, 3), (7, 3), (0, 20)], t: 4, at: (0, -5.5, 0)), color: white),
  organic.paint(organic.ball(d: 17, at: (0, 0, 27)), color: tip),
]

part zephyr_fox {
  material: "PLA"
  body organic.model([
    // body and short legs
    organic.egg(size: (33, 42, 31), at: (0, 6, 27)),
    organic.limb(from: (8.5, -5, 24), to: (9, -7, 6), d: 13, d2: 12, mirror: true),
    organic.limb(from: (8.5, 17, 24), to: (9, 18, 6), d: 13.5, d2: 12, mirror: true),
    organic.egg(size: (12, 15, 8), at: (8.5, -10, 4), blend: 2, mirror: true),
    organic.egg(size: (12, 15, 8), at: (8.5, 17, 4), blend: 2, mirror: true),
    // big head, muzzle, nose and pointed cheek fluff
    organic.egg(size: (60, 50, 52), at: (0, -12, 63), blend: 9),
    organic.egg(size: (22, 18, 15), at: (0, -37, 54), color: white, blend: 5),
    organic.ball(d: 6.5, at: (0, -46, 57), color: nose, blend: 1.5),
    organic.limb(from: (16, -25, 53), to: (28, -22, 49), d: 16, d2: 5, color: white, blend: 4, mirror: true),
    // ears
    organic.group(ear, at: (15, -12, 81), rotate: (0, 20, 0), mirror: true),
    // tail sweeping back to a white cloud swirl
    organic.limb(from: (0, 26, 30), to: (0, 47, 45), d: 10, d2: 21, blend: 5),
    organic.ring(d: 22, tube: 13, at: (0, 58, 54), axis: X, color: white, blend: 4),
    organic.ball(d: 13, at: (0, 58, 54), color: white, blend: 2),
    // white lower face, chest and paw tips
    organic.paint(organic.egg(size: (46, 30, 22), at: (0, -32, 49)), color: white),
    organic.paint(organic.egg(size: (22, 16, 26), at: (0, -16, 34)), color: white),
    organic.paint(organic.block(size: (60, 50, 7), at: (0, 5, 2.5), r: 1), color: white),
  ], style: "lowpoly", tris: 2600, color: sky, blend: 4)
}

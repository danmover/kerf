buy "Medium threadlocker" { qty: 1, price: 7, search: "medium strength threadlocker blue" }
buy "Double-sided foam tape (boards)" { qty: 1, price: 6, search: "double sided foam mounting tape" }
buy "Play sand for the test box, 25 kg" { qty: 4, price: 8, search: "play sand 25kg" }
buy "Woven sandbags for the box load" { qty: 8, price: 1, search: "woven polypropylene sandbags" }
buy "Plywood 12 mm, 1200 × 600 mm (test box)" { qty: 1, price: 15, search: "12mm plywood sheet 1200x600" }
buy "Push pole: broom handle or 25 mm dowel, 1.2 m" { qty: 1, price: 6, search: "25mm wooden dowel 1200mm" }

// ── Requirements ─────────────────────────────────────────
require "Screws push harder than the sand resists" for cross: front.thrust + rear.thrust >= 1.3 * (front.resist + rear.resist)
require "One person can push it in from the wall until the rear screw bites" for cross: start_push <= 150N
require "Front motor runs below half its stall torque" for cross: front_pt.load_fraction <= 0.5
require "Rear motor runs below half its stall torque" for cross: rear_pt.load_fraction <= 0.5
require "Battery lasts two crossings" for reserve: run.minutes >= 2 * crossing_min
require "Battery covers giving up and backing out the whole way" for reserve: run.time >= 2 * give_up
require "Body friction stops it rolling with the screws" for cross: roll_hold >= 3 * abs(front.torque - rear.torque)
require "Steering has twice the moment it needs" for steer: steer_have.moment >= 2 * steer_need.moment
require "Steering holds without power" for steer: steer_have.hold_moment >= steer_need.moment
require "The slot ends stop the hinge just past the steering limit" for steer: atan(slot_half * cam_slope / pin_x) >= steer_max
require "Main power wire is thick enough" for cross: power_wire.awg >= main_awg
require "Flights can carry most of the sand the shell displaces" soft for cross: convey.ratio >= 0.5

// ── Simulations: the pit from the brief, run with the real firmware ──
// The robot as the simulation sees it: two screw sections either side of the hinge.
let tunneller = sim.screw_tunneller(
  screws: [
    sim.screw(motor: m_front, d: flight_d, core: shell_d, pitch: pitch, from: f_fl0, length: front_flight_l, face: true),
    sim.screw(motor: m_rear, d: flight_d, core: shell_d, pitch: pitch, from: r_fl0, length: rear_flight_l, dir: -X)
  ],
  delta: sand_delta, body: body_od, between: (r_shell0, f0), nose: nose_tip, tail: r_shell_end - tail_l,
  hinge: sim.cam_hinge(actuator: steer, arm: pin_x, slope: cam_slope, mid: act_mid, stop: atan(slot_half * cam_slope / pin_x), extend: "left")
)

scenario "Cross the pit" for cross, steer, reserve {
  // started from the hole in the near wall, pushed in by the tail (push cup on a pole) until the rear screw bites
  world: sim.sand_pit(length: pit_l, width: pit_w, depth: pit_depth, axis: floor_gap, start: "wall", exit: flight_d + 200mm, push: 150N)
  robot: tunneller
  firmware: brain
  duration: 20min
  expect "Reaches the far wall": reached
  expect "Comes out through the opening": through
  expect "Arrives within 100 mm of the line": miss < 100mm
  expect "Motors stay below 80 °C" soft: m_front.max_temp < 80C && m_rear.max_temp < 80C
  expect "Battery left to back out": battery_left > 50%
}

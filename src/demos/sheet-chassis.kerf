design "Sheet-Metal Chassis"
note "Bent aluminium electronics chassis: a tray and a U-shaped cover, each cut and bent from one 1.5 mm sheet with sheet(), joined by four M3 button screws into nyloc nuts. Each part has a flat-pattern drawing with its bend table, and Export → Flat patterns gives the laser a 1:1 DXF."

// ── Sizes ──────────────────────────────────────────────
param width  = 160mm range 80 .. 300 "Outside width of the tray"
param depth  = 110mm range 60 .. 250 "Front to back"
param height = 45mm  range 30 .. 120 "Height of the tray's front and back"
param t      = 1.5mm range 1 .. 3    "Sheet thickness"
param side_h = 20mm  range 14 .. 40  "How far the cover's sides come down"

let bend_r  = t
// the cover slides over the tray's sides with this much room each side
let clear   = 0.2
let cover_w = width + 2 * (t + clear)
// the tray's sides stop under the cover's bends
let wall_h  = height - bend_r - 0.5
let screw_z = height - 9
let screw_y = [-depth / 2 + 18, depth / 2 - 18]

// ── The tray: base, front and back to full height, sides tucked under the cover ──
part tray {
  material: "Aluminum 5052"
  body sheet(rect(width, depth), t: t, r: bend_r, flanges: [flange("front", height), flange("back", height), flange("left", wall_h), flange("right", wall_h)])
  // front panel: power jack, switch and LED
  cut hole(d: 8, depth: 5, at: (-width / 2 + 25, -depth / 2 - 1, height / 2), dir: Y)
  cut hole(d: 12, depth: 5, at: (0, -depth / 2 - 1, height / 2), dir: Y)
  cut hole(d: 5, depth: 5, at: (width / 2 - 25, -depth / 2 - 1, height / 2), dir: Y)
  // cable gland in the back
  cut hole(d: 16, depth: 5, at: (0, depth / 2 + 1, height / 2), dir: -Y)
  // cover screw holes in the sides
  for y in screw_y {
    cut hole(d: 3.4, depth: 5, at: (width / 2 + 1, y, screw_z), dir: -X)
    cut hole(d: 3.4, depth: 5, at: (-width / 2 - 1, y, screw_z), dir: X)
  }
}

// ── The cover: a top with its two sides bent down over the tray ──
part cover {
  material: "Aluminum 5052"
  // comes off for service
  removable
  body sheet(rect(cover_w, depth), t: t, r: bend_r, flanges: [flange("left", side_h, angle: -90), flange("right", side_h, angle: -90)], at: (0, 0, height))
  // vent slots across the top
  for k in range(6) {
    cut slot(length: 50, width: 4, depth: 5, at: (0, -25 + k * 10, height + t + 1), dir: -Z)
  }
  for y in screw_y {
    cut hole(d: 3.4, depth: 5, at: (cover_w / 2 + 1, y, screw_z), dir: -X)
    cut hole(d: 3.4, depth: 5, at: (-cover_w / 2 - 1, y, screw_z), dir: X)
  }
}

// ── Fasteners: button screws through the cover and tray sides into nyloc nuts inside ──
component screws_r = lib.screw(M3, 10, head: "button") { at: [(cover_w / 2, screw_y[0], screw_z), (cover_w / 2, screw_y[1], screw_z)], axis: -X }
component screws_l = lib.screw(M3, 10, head: "button") { at: [(-cover_w / 2, screw_y[0], screw_z), (-cover_w / 2, screw_y[1], screw_z)], axis: X }
component nuts_r = lib.nut(M3, type: "nyloc") { at: [(width / 2 - t, screw_y[0], screw_z), (width / 2 - t, screw_y[1], screw_z)], axis: -X }
component nuts_l = lib.nut(M3, type: "nyloc") { at: [(-width / 2 + t, screw_y[0], screw_z), (-width / 2 + t, screw_y[1], screw_z)], axis: X }

require "Cover sides reach well past the screws" : side_h - t - (height - screw_z) >= 3 * t
require "Screws clear the tray's front and back" : depth / 2 - 18 >= 10

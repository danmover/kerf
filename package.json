{
  "name": "kerf",
  "version": "0.1.8",
  "description": "Kerf: AI-directed mechanical CAD",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc && vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server/dist/index.js",
    "preview": "vite preview",
    "desktop": "npm run build && node scripts/build-desktop.mjs && electron .desktop/app",
    "desktop:dist": "npm run build && node scripts/build-desktop.mjs && electron-builder --config desktop/electron-builder.yml --publish never",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p tests && tsc -p server && tsc -p server/tests && tsc -p desktop",
    "server:admin": "tsx server/src/admin.ts",
    "server:secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\""
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.1",
    "framer-motion": "^11.11.9",
    "hono": "^4.13.9",
    "nodemailer": "^10.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.169.0",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.8.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
